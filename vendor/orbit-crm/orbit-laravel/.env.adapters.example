# Orbit (Laravel) — platform adapters: AI / OCR / email / events / jobs.
#
# Pluggable-and-mock law: every adapter below degrades to a local fallback
# (heuristic scoring, keyword-matched copilot, manual-entry OCR stub, log-only
# email/notifications) when its env vars are unset. Copy the vars you want into
# your real .env — nothing else needs to change, and the app is always
# demoable with none of this set. See app/Services/AiService.php,
# app/Services/OcrService.php, app/Services/Copilot.php, app/Services/Notifier.php.

# ── LLM (AiService, Copilot classifier) ─────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint: Groq, OpenRouter, Together,
# a local Ollama server, etc. Both LLM_BASE_URL and LLM_API_KEY must be set to
# enable live AI (lead scoring / follow-up drafts / call summaries / NL copilot
# classification) — otherwise AiService::aiEnabled() is false and everything
# degrades to the deterministic local heuristic / keyword matcher.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ── OCR (OcrService::extractInvoice) ────────────────────────────────────────
# A VISION-capable model id on the same LLM_BASE_URL/LLM_API_KEY above (the
# plain text LLM_MODEL usually won't do vision — use a separate vision model,
# e.g. a Groq/OpenRouter vision model id). Requires LLM_BASE_URL + LLM_API_KEY
# too; OcrService::ocrConfigured() is true only when all three are set.
OCR_MODEL=

# ── Email (Notifier::notify) ────────────────────────────────────────────────
# Reuses Laravel's own mail config (config/mail.php) — no separate adapter env.
# Leave MAIL_MAILER=log (the Laravel default) to keep email a no-op logged
# locally; Notifier::emailConfigured() only returns true once MAIL_MAILER is a
# real transport (e.g. "smtp") AND host/username/password/from-address are set.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@orbit.example
MAIL_FROM_NAME="Orbit"

# ── Jobs / scheduler (JobRunner::runDue, registered in routes/console.php) ──
# Laravel's own scheduler (`php artisan schedule:run`, cron every minute) calls
# JobRunner::runDue() directly — no secret needed for that path. CRON_SECRET is
# reserved for an optional secured HTTP trigger (POST /api/cron, mirroring
# lib/jobs.ts) for hosts without OS cron access; only wire it up if/when that
# route is added. Bearer-check it in the controller: compare the request's
# Authorization header against this value.
CRON_SECRET=
