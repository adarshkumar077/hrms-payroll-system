# Copy this file to connector/.env and fill in the values for your setup.
# Lines starting with # are ignored. No quoting needed unless a value has spaces.

# --- Orbit side --------------------------------------------------------
# Base URL of the running Orbit app (no trailing slash needed).
ORBIT_URL=http://localhost:3000

# The connector token generated on the Tally card at /integrations.
# It is shown ONCE at generation time in the Orbit UI — copy it here immediately.
ORBIT_CONNECTOR_KEY=

# --- Tally side ----------------------------------------------------------
# Tally's HTTP/XML server. Default port is 9000. Tally must be running with
# the target company OPEN and "Enable ODBC / HTTP Server" turned on
# (Gateway of Tally > F1 (Help) > Settings > Connectivity, or F12 config
# depending on version — see README.md for exact steps).
TALLY_URL=http://localhost:9000

# Optional: pins requests to a specific open company by name. Leave blank to
# use whichever company is currently open in Tally.
TALLY_COMPANY_NAME=

# --- Sync cadence --------------------------------------------------------
# Seconds between sync cycles. 0 = run exactly one cycle and exit (useful for
# cron/Task Scheduler or a one-off manual sync).
SYNC_INTERVAL_SEC=300

# --- Ledger names for tax lines -------------------------------------------
# Every Tally chart of accounts is set up a little differently. These map the
# Sales voucher's tax lines to the exact ledger names that exist in YOUR
# Tally company. Must match Tally's ledger names exactly (case-sensitive as
# far as Tally is concerned) or the voucher import will fail with a
# LINEERROR ("Ledger does not exist").
TALLY_LEDGER_SALES=Sales
TALLY_LEDGER_CGST=Output CGST
TALLY_LEDGER_SGST=Output SGST
TALLY_LEDGER_IGST=Output IGST
