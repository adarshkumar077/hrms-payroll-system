# Copy to .env.production on your VPS — never commit real secrets
# Start: docker compose --env-file .env.production up -d --build
# With Cloudflare Tunnel: docker compose --env-file .env.production --profile tunnel up -d --build

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=eitf
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password_min_24_chars
POSTGRES_DB=eitf_hrms

# ── Auth (min 32 characters each) ───────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_characters_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Public URL (REQUIRED for production) ─────────────────────────────────────
PUBLIC_APP_URL=https://hrms.yourcompany.com
CORS_ORIGINS=https://hrms.yourcompany.com
# Leave NEXT_PUBLIC_API_URL empty for same-origin /api/v1 (recommended)
NEXT_PUBLIC_API_URL=

# ── Nginx ports (VPS direct access; use 80/443 when not using Cloudflare Tunnel) ──
PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_PORT=8443

# ── Cloudflare Tunnel (recommended — one permanent HTTPS URL, no IP exposure) ─
# Create tunnel at: https://one.dash.cloudflare.com → Zero Trust → Networks → Tunnels
# Public hostname → Service: http://nginx:80
CLOUDFLARE_TUNNEL_TOKEN=

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUP_INTERVAL_SEC=86400
BACKUP_RETENTION_DAYS=14

# ── Optional load-test credentials (scripts only) ─────────────────────────────
LOAD_TEST_USER=superadmin
LOAD_TEST_PASS=Super@123
