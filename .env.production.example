# Copy to .env.production on your VPS — never commit real secrets
# Start: docker compose --env-file .env.production up -d --build
# With Cloudflare Tunnel: docker compose --env-file .env.production --profile tunnel up -d --build

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=eitf
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password_min_24_chars
# Separate login for the running API (read/write rows only; no schema changes, not superuser).
# Letters/digits only, 24+ chars:  openssl rand -hex 32
APP_DB_PASSWORD=
POSTGRES_DB=eitf_hrms

# ── Auth (min 32 characters each; generate with: openssl rand -base64 48) ───
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_generate_with_openssl_rand
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_generate_with_openssl_rand
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Web refresh token is an httpOnly Secure cookie. Set false ONLY for plain-http local dev
# (also drops CSP upgrade-insecure-requests on the web app).
COOKIE_SECURE=true

# ── Integration secret encryption (generate with: openssl rand -base64 48) ──
INTEGRATION_SECRET_KEY=CHANGE_ME_integration_key_generate_with_openssl_rand

# ── Bootstrap admin (first-run superadmin; change the password after login) ─
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password_min_16_chars

# ── Reverse proxy (nginx / Cloudflare Tunnel sits in front of the API) ──────
# Which proxy hops to trust for the client IP. Default (empty) trusts only private/loopback
# hops (nginx, cloudflared, Docker) and works for both nginx and Cloudflare Tunnel setups.
# Set to 'false' if the API is exposed directly with no proxy.
TRUST_PROXY=

# ── Public URL (REQUIRED for production) ─────────────────────────────────────
PUBLIC_APP_URL=https://hrms.yourcompany.com
CORS_ORIGINS=https://hrms.yourcompany.com
# Leave NEXT_PUBLIC_API_URL empty for same-origin /api/v1 (recommended)
NEXT_PUBLIC_API_URL=

# ── Nginx ports (VPS direct access; use 80/443 when not using Cloudflare Tunnel) ──
PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_PORT=8443

# ── HTTPS by server IP (LAN / intranet, option C) ─────────────────────────────
# Make certificates first:  bash deploy/ip-https/make-certs.sh <SERVER_IP>
# Then uncomment these (and set PUBLIC_HTTP_PORT=80, PUBLIC_HTTPS_PORT=443 above,
# PUBLIC_APP_URL / CORS_ORIGINS = https://<SERVER_IP>). Requires Docker Compose 2.24+.
# COMPOSE_FILE=docker-compose.yml:docker-compose.ip-https.yml
# Bind nginx to one network interface only (default 0.0.0.0 = all interfaces):
# NGINX_BIND_IP=<SERVER_IP>

# ── Cloudflare Tunnel (recommended — one permanent HTTPS URL, no IP exposure) ─
# Create tunnel at: https://one.dash.cloudflare.com → Zero Trust → Networks → Tunnels
# Public hostname → Service: http://nginx:80
CLOUDFLARE_TUNNEL_TOKEN=

# ── Object storage (selfies + HR documents) ──────────────────────────────────
# local = files on the API host (LOCAL_STORAGE_DIR, default ./uploads; must be a persistent volume).
# s3    = S3-compatible: AWS S3, Cloudflare R2, Backblaze B2. The DB stores only object keys.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=
# Public base URL of the API, used to build signed selfie links for the local driver
# (e.g. https://hrms.yourcompany.com). Empty = same-origin relative /api/v1/... links.
API_PUBLIC_URL=
# HMAC secret for local-driver signed links (falls back to JWT_ACCESS_SECRET if empty).
STORAGE_SIGNING_SECRET=
# --- s3 driver only ---
# R2:  S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  S3_REGION=auto
# B2:  S3_ENDPOINT=https://s3.<region>.backblazeb2.com           S3_REGION=<region>
# AWS: leave S3_ENDPOINT empty, S3_REGION=ap-south-1
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO / path-style endpoints; R2 and AWS work with false.
S3_FORCE_PATH_STYLE=false
# Origin browsers load presigned selfie URLs from (web CSP img-src), e.g.
# https://<bucket>.<accountid>.r2.cloudflarestorage.com  (path-style: https://<accountid>.r2.cloudflarestorage.com)
STORAGE_PUBLIC_ORIGIN=

# ── Mobile OTP login by email (employees only; see docs/EMAIL_OTP_SETUP.md) ───
# The employee enters their mobile number; the OTP goes to the email on their employee record.
# Leave SMTP_HOST empty to keep OTP login switched off (there is no fake/console delivery).
SMTP_HOST=
# 587 = STARTTLS (required), 465 = implicit TLS
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EITF HRMS
# Shown in OTP emails ("Need help? Contact …"), e.g. hr@yourcompany.com
SUPPORT_CONTACT=
# Outgoing email cap per minute (protects the mail account / domain reputation)
MAIL_MAX_PER_MINUTE=60
# Comma-separated administrator addresses for system alerts (backup / disk / email / login alerts)
ALERT_EMAILS=
# HMAC key for stored OTP hashes (generate with: openssl rand -base64 48)
OTP_HASH_SECRET=

# ── AI assistant (optional) ───────────────────────────────────────────────────
# Empty OPENAI_API_KEY = built-in rules engine (nothing leaves the server).
# With a key, assistant questions and HR context are sent to OpenAI — decide this deliberately.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_SYSTEM_PROMPT=

# ── Optional load/smoke-test credentials (scripts only) ───────────────────────
# A real admin login that has already changed its first password. Leave empty otherwise.
LOAD_TEST_USER=
LOAD_TEST_PASS=

# ── Compose profiles started by `docker compose` and the systemd unit ─────────
# tunnel = Cloudflare Tunnel (option A), ssl = nginx + Let's Encrypt renewal (option B),
# empty = neither (option C, LAN only). See docs/HOSTING-DEDICATED-SERVER.md.
COMPOSE_PROFILES=
