# Shared / Docker
POSTGRES_USER=eitf
POSTGRES_PASSWORD=eitf_dev_password
POSTGRES_DB=eitf_hrms
POSTGRES_PORT=5432
REDIS_PORT=6379

# API
DATABASE_URL=postgresql://eitf:eitf_dev_password@localhost:5435/eitf_hrms?schema=public
REDIS_URL=redis://localhost:6379
# Secrets: generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Web refresh token is an httpOnly Secure cookie. Set false ONLY for plain-http local dev
# (also drops CSP upgrade-insecure-requests on the web app).
COOKIE_SECURE=true
INTEGRATION_SECRET_KEY=change-me-integration-key-generate-with-openssl
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
# Which proxy hops to trust for the client IP. Default (empty) trusts only private/loopback
# hops (nginx, cloudflared, Docker) and works for both nginx and Cloudflare Tunnel setups.
# Set to 'false' if the API is exposed directly with no proxy.
TRUST_PROXY=
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
S3_ENDPOINT=
S3_BUCKET=eitf-hrms
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Mobile OTP login (employee accounts only) — see docs/SMS-OTP-LOGIN.md.
# OTP policy is fixed in code: 6 digits, 5-minute expiry, single use, 30 s resend cooldown.
# Leave SMS_PROVIDER empty to keep OTP login switched off (there is no fake/console SMS).
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Template variable that carries the code (default: otp)
MSG91_OTP_VAR=otp
# HMAC key for stored OTP hashes (generate with: openssl rand -base64 48)
OTP_HASH_SECRET=
EMAIL_PROVIDER=console

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Local DB without Docker: npm run db:up  (embedded Postgres on port 5433)
# Optional Docker still supported via docker-compose.yml (port 5432)
