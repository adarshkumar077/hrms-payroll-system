# Shared / Docker
POSTGRES_USER=eitf
POSTGRES_PASSWORD=eitf_dev_password
POSTGRES_DB=eitf_hrms
POSTGRES_PORT=5432
REDIS_PORT=6379

# API
DATABASE_URL=postgresql://eitf:eitf_dev_password@localhost:5435/eitf_hrms?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
OTP_TTL_SECONDS=300
OTP_LENGTH=6
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
S3_ENDPOINT=
S3_BUCKET=eitf-hrms
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
SMS_PROVIDER=console
EMAIL_PROVIDER=console

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Local DB without Docker: npm run db:up  (embedded Postgres on port 5433)
# Optional Docker still supported via docker-compose.yml (port 5432)
