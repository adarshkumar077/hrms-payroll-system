# ── Orbit — PRODUCTION env template ─────────────────────────────────────────
# Copy to .env on the server and fill in. NEVER commit the real .env.
# Generate a fresh key on the server:  php artisan key:generate

APP_NAME=Orbit
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-domain.com

# Comma-separated origin(s) of the deployed SPA (used by config/cors.php).
FRONTEND_URLS=https://app.your-domain.com

# Sanctum bearer-token lifetime in MINUTES (default 7 days). Rotate on the SPA.
SANCTUM_EXPIRATION=10080
SANCTUM_STATEFUL_DOMAINS=app.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── MySQL (cPanel / shared host) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db
DB_USERNAME=your_db_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail (set real SMTP before go-live; 'log' just writes to storage/logs) ──
MAIL_MAILER=log

# ── AI (optional; blank ⇒ deterministic local fallback, app still works) ──
# Rotate any key that was ever pasted into a chat before using it here.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
