# ─────────────────────────────────────────────────────────────
# Orbit — production environment (EXAMPLE — placeholders only, no real secrets)
# Copy to `.env.production` and fill in, or set these in your host's env UI.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# SQLite (single container, volume-mounted):
#   DATABASE_URL="file:/app/data/orbit.db"
# PostgreSQL (recommended for prod):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/orbit?schema=public"

# When using Postgres, tell the entrypoint which Prisma schema to push.
# (Omit / leave default for SQLite.)
PRISMA_SCHEMA="prisma/schema.postgres.prisma"

# ── Auth ──────────────────────────────────────────────────────
# REQUIRED in prod. Generate a strong value, e.g.:  openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_to_a_strong_random_32+_char_secret"

# ── AI layer (optional) ───────────────────────────────────────
# Any OpenAI-compatible endpoint. Unset -> Orbit uses its local heuristic fallback.
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="your_provider_api_key"
LLM_MODEL="llama-3.3-70b-versatile"

# Alternatively, native Anthropic (used only if LLM_* is unset):
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-4-8"
