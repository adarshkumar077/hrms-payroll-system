# Normalise line endings. Files that run inside Linux containers / on the Linux server must keep LF
# even when the repository is checked out on Windows (core.autocrlf=true would turn them into CRLF
# and break the shebang / shell parsing).
* text=auto
*.sh text eol=lf
*.conf text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.service text eol=lf
*.sql text eol=lf
docker-entrypoint.sh text eol=lf
# Binary
*.png binary
*.jpg binary
*.ico binary
*.xlsx binary
*.pdf binary
